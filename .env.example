# Copy to .env for local development. Never commit .env.
# Fields without a default in app/core/config.py are REQUIRED — the app fails
# fast at startup if they are missing.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=local                 # local | staging | production
APP_DEBUG=true
APP_NAME=Real Estate Platform API
# REQUIRED — min 32 chars. Generate: `openssl rand -hex 32`
APP_SECRET_KEY=_aly0k7CH1mS3e089BsZ1Py3OFhj3P3BuBfEZ8ejMmTtHawY5-Zvy3zpmuFOW2lX

# ── Database (REQUIRED) ────────────────────────────────────────────────────
# The app connects as the non-superuser role so Postgres RLS applies;
# migrations (Alembic) use the owner DDL URL.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/realestate
DATABASE_DDL_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/realestate

# ── Redis (cache / Celery broker+backend / rate limit / pub-sub) ────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
TENANT_CACHE_TTL_SECONDS=300

# ── Auth / tokens ──────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=86400

# ── Object storage (REQUIRED keys — MinIO in local dev) ─────────────────────
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
STORAGE_REGION=us-east-1
STORAGE_MEDIA_BUCKET=media
STORAGE_DOCS_BUCKET=media-private
# CDN base for public variant URLs; empty = serve straight from the endpoint.
MEDIA_PUBLIC_BASE_URL=

# ── Email (Mailpit in local dev) ───────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@realestate.local

# ── Tenant lifecycle & billing (§8.16) ─────────────────────────────────────
BILLING_PROVIDER=stub
# REQUIRED outside app_env=local. The webhook endpoint is unauthenticated by
# design — this signature is its only authentication — so leaving the value
# below in place lets anyone forge subscription events. Startup refuses it when
# APP_ENV is staging or production.
BILLING_WEBHOOK_SECRET=dev-billing-webhook-secret
TRIAL_LENGTH_DAYS=14
BILLING_GRACE_DAYS=7
OFFBOARD_DELETION_DELAY_DAYS=30
IMPERSONATION_TOKEN_TTL_SECONDS=900

# ── AI features (§8.18) — offline stub by default ──────────────────────────
AI_PROVIDER=stub              # stub | anthropic
AI_API_KEY=
AI_MODEL=claude-opus-4-8
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1024

# ── Domain sweeps (§8.1 / §8.4) ────────────────────────────────────────────
LISTING_STALE_AFTER_DAYS=90
LEAD_ESCALATION_MINUTES=30

# ── Observability (§14) — every exporter is opt-in and offline-safe ────────
# Error tracking. Empty DSN = Sentry never initialises.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Tag events with the deployed revision (set to the image tag / git SHA in CI).
SENTRY_RELEASE=
# Distributed tracing. Needs BOTH the flag and an OTLP HTTP endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=            # e.g. http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=real-estate-backend
# Prometheus scraping at GET /internal/metrics. Needs no credentials, so it is
# on by default; the reverse proxy already 404s /internal/* from the public
# internet. Set a token to additionally require `Authorization: Bearer <token>`
# on a scrape (recommended in production — defence in depth if the proxy rule
# is ever misconfigured).
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

# ── HTTP / CORS ────────────────────────────────────────────────────────────
# An agency site's own domain is allowed dynamically: the Origin is resolved
# through the same Redis-cached host→tenant lookup as the request, and is
# reflected only when both land on the same tenant (§10.1). Nothing needs to
# be listed here for that. This list is the *additive* allowlist for origins
# belonging to no tenant — the platform back-office SPA, local dev frontends.
# Comma-separated, exact match. Never widened to `*`.
CORS_ORIGINS=http://localhost:3000

# ── Edge hardening (§10.1–§10.2) ───────────────────────────────────────────
# HSTS is sent when APP_ENV is staging/production (TLS terminates at Caddy) or
# the request arrived over https — never on plain-http local dev, where a
# cached max-age would pin localhost to https in your browser for a year.
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Layered rate limits, both degrade open when Redis is unavailable. The global
# budget is a coarse per-IP backstop in front of everything (health probes and
# /internal are exempt); the auth budget is per tenant+IP per action on
# login/register/refresh/password-reset. Rejections carry Retry-After.
GLOBAL_RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Trusted reverse proxies. Behind Caddy every socket peer is the proxy, so
# without this the whole internet shares one rate-limit budget and the per-IP
# login lockout can be tripped for everyone by one attacker. X-Forwarded-For is
# trusted ONLY when the peer is inside these CIDRs — never otherwise, or any
# caller could forge a fresh identity per request. Empty = trust nothing (use
# the raw peer), which is correct for a directly-exposed app.
# The docker/ compose topology puts Caddy on the default bridge:
#   TRUSTED_PROXY_CIDRS=172.16.0.0/12
TRUSTED_PROXY_CIDRS=
# Hops your trusted edge adds. 1 = Caddy only (the §16 topology); 2 if a CDN
# sits in front of it. The client is counted from the RIGHT of the header, so
# prepended entries from an attacker can never displace it.
TRUSTED_PROXY_HOPS=1

# ── Data protection (§10.7, §9) ─────────────────────────────────────────────
# REQUIRED — min 32 chars, deliberately separate from APP_SECRET_KEY so
# rotating one never touches the other. Generate: `openssl rand -hex 32`
FIELD_ENCRYPTION_KEY=kD-jLymn_Csk409iJbG3sg7RM2gStcwQLnGgMzE1wNtr_bbZBUxWD-fuLBP9xUFZ
FIELD_ENCRYPTION_KEY_ID=v1
# Retired keys kept only so already-encrypted rows keep decrypting through a
# rotation: "id1=key1,id2=key2". Empty until a rotation is in progress.
FIELD_ENCRYPTION_KEYS=
# Idempotency-Key header (§9): a replayed key returns the cached response
# instead of re-executing the request; 24h covers a client retrying well
# after a timeout.
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# ── Caching & performance (§11) ────────────────────────────────────────────
# Redis cache-aside for hot anonymous reads (site config, content pages, map
# clusters) + CDN Cache-Control on public GETs. The whole layer degrades open
# on any Redis error; CACHE_ENABLED=false turns it off entirely. Per-entity
# TTLs are the staleness budgets from §11; a write bumps a version counter so
# the Redis layer stays correct. PUBLIC_CACHE_S_MAXAGE_SECONDS is the shared-
# cache window a CDN may serve an anonymous public GET for.
CACHE_ENABLED=true
CACHE_SITE_CONFIG_TTL_SECONDS=300
CACHE_CONTENT_TTL_SECONDS=300
CACHE_FACETS_TTL_SECONDS=60
CACHE_MAP_TTL_SECONDS=60
PUBLIC_CACHE_S_MAXAGE_SECONDS=60

# ── Outbound webhooks + SSRF guard (§8.14, §10.4) ──────────────────────────
# A tenant-registered webhook target must resolve to a public address; the
# SSRF guard blocks private/loopback/link-local ranges (cloud metadata service,
# internal admin ports, RFC-1918 hosts) at registration and on every delivery
# hop. Leave this OFF in production — set it true only for local dev/tests that
# deliver to a mock on 127.0.0.1.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# ── Auth hardening (§7.1, §10.3) ───────────────────────────────────────────
# Account lockout: failed logins are counted per account *and* per source IP.
# Past the threshold the account is locked for a window that doubles with each
# further failure, up to the cap; a successful login clears both counters.
# Unlike the rate limiter, this is the layer guarding one specific account
# against credential stuffing that stays inside any per-minute budget.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_FAILURE_WINDOW_SECONDS=900
# The per-IP failure budget is deliberately much larger than the per-account
# one: many legitimate users share one public IP (corporate NAT, mobile
# CGNAT), so a low IP threshold would let one bad client behind a shared egress
# lock everyone out. This key only exists to blunt one host spraying many
# accounts.
LOGIN_IP_MAX_FAILED_ATTEMPTS=50
# Breached-password check via HIBP's k-anonymity range API: only the first 5
# hex chars of the password's SHA-1 ever leave the process. Deliberately
# fail-open — a third party being down must never block signup or a reset.
# Set false for air-gapped deploys (and it is off in the test suite).
HIBP_ENABLED=true
HIBP_API_URL=https://api.pwnedpasswords.com/range
HIBP_TIMEOUT_SECONDS=3.0
# MFA/TOTP. The issuer is what shows in the authenticator app. The pending
# token is a short-lived second-factor ticket, not a session — it is
# single-use, so one ticket buys exactly one code guess.
MFA_ISSUER=Real Estate Platform
MFA_PENDING_TOKEN_TTL_SECONDS=300
MFA_TOTP_VALID_WINDOW=1
# OAuth social login — seam only. Without both a client id and a secret the
# routes report "not configured" (501) instead of half-working; setting them
# flips the provider on with no code change. OAUTH_REDIRECT_BASE_URL is the
# public origin the provider redirects back to (e.g. https://agency.example).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=

# ── Deployment (docker/docker-compose.prod.yml) ────────────────────────────
# ACME_EMAIL=admin@example.com
# WEB_CONCURRENCY=2
# CELERY_CONCURRENCY=2
# RUN_MIGRATIONS=1            # set 0 on non-migrating API replicas (§16)
