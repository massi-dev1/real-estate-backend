# Copy to .env for local development. Never commit .env.
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-generate-a-long-random-string

# App connects as the non-superuser role (RLS enforcement); migrations use the DDL URL.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/realestate
DATABASE_DDL_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/realestate

REDIS_URL=redis://localhost:6379/0

# Interim shared key guarding /api/v1/platform/* (replaced by real auth in Part 3)
PLATFORM_API_KEY=change-me-generate-a-long-random-string

# Outbound email (Mailpit in local dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# CORS: comma-separated exact origins (tenant domains are added dynamically later)
CORS_ORIGINS=http://localhost:3000
