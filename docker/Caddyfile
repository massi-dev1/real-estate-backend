# Caddy reverse proxy (§16) — automatic HTTPS in front of the FastAPI app.
#
# Multi-tenant custom domains use ON-DEMAND TLS: Caddy obtains a certificate the
# first time a domain is requested, but only after asking the app whether that
# domain is a verified tenant domain (§8.16). This prevents an attacker from
# pointing arbitrary hostnames at us and exhausting the ACME rate limit.
#
# The `ask` endpoint is the app's internal GET /internal/tls-check?domain=...
# which returns 200 for a verified tenant domain and 404 otherwise.

{
	# On-demand TLS is only issued for domains the app approves.
	on_demand_tls {
		ask http://app:8000/internal/tls-check
		interval 2m
		burst 5
	}

	# ACME contact for Let's Encrypt (override via env in prod).
	email {$ACME_EMAIL:admin@example.com}
}

# Every tenant host is served by the same app; TLS is issued on demand.
https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	# Defense-in-depth: as of Part 28 the app sets HSTS itself (whenever
	# APP_ENV is staging/production or the request arrived over https), and
	# `header` *replaces* rather than appends, so this is one value not two.
	# Keeping it at the edge means HSTS survives an app misconfiguration, and
	# vice versa — TLS terminates here, so this is where it is guaranteed
	# meaningful. Keep the max-age in sync with HSTS_MAX_AGE_SECONDS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The internal TLS-check endpoint must never be reachable from the public
	# internet — it is for Caddy's ask handler only (same Docker network).
	@internal path /internal/*
	respond @internal 404

	reverse_proxy app:8000 {
		health_uri /readyz
		health_interval 10s
		health_timeout 5s
	}
}
